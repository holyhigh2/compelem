{
  "name": "compelem",
  "version": "0.30.0-beta.1",
  "description": "A modern, reactive, fast, lightweight and flexible lib for building web components",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs.js"
      },
      "development": {
        "import": {
          "types": "./dist-dev/index.d.ts",
          "default": "./dist-dev/index.esm.js"
        },
        "require": {
          "types": "./dist-dev/index.d.cts",
          "default": "./dist-dev/index.cjs.js"
        }
      },
      "production": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.esm.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs.js"
        }
      }
    }
  },
  "author": "holyhigh2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holyhigh2/compelem.git"
  },
  "bugs": "https://github.com/holyhigh2/compelem/issues",
  "keywords": [
    "typescript",
    "webcomponent",
    "reactive"
  ],
  "files": [
    "dist/",
    "dist-dev/",
    "llms.txt",
    "README.md",
    "LICENSE",
    ".agents/"
  ],
  "scripts": {
    "lint": "eslint src/**",
    "build": "npm run build:prod && npm run build:dev",
    "build:prod": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "dev": "vite --config vite.config.dev.mts",
    "typecheck": "tsc --noEmit",
    "pack": "npm pack"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "eslint": "9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "myfx": "^2.0.0-beta.2",
    "prettier": "^2.8.3",
    "sass": "^1.72.0",
    "terser": "^5.51.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1"
  }
}