{
  "name": "compelem",
  "version": "0.28.2",
  "description": "A modern, reactive, fast, lightweight and flexible lib for building web components",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs.js"
      },
      "development": {
        "import": {
          "types": "./dist-dev/index.d.ts",
          "default": "./dist-dev/index.esm.js"
        },
        "require": {
          "types": "./dist-dev/index.d.cts",
          "default": "./dist-dev/index.cjs.js"
        }
      },
      "production": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.esm.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs.js"
        }
      }
    }
  },
  "author": "holyhigh2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holyhigh2/compelem.git"
  },
  "bugs": "https://github.com/holyhigh2/compelem/issues",
  "keywords": [
    "typescript",
    "webcomponent",
    "reactive"
  ],
  "files": [
    "dist/",
    "dist-dev/",
    "llms.txt",
    "README.md",
    "LICENSE",
    ".agents/"
  ],
  "scripts": {
    "lint": "eslint src/**",
    "build": "rollup --config",
    "test": "rollup --config rollup.config.test.js --watch",
    "pack": "npm pack"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.26.0",
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-json": "4.1.0",
    "@rollup/plugin-node-resolve": "14.1.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "0.4.1",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "autoprefixer": "^10.4.19",
    "eslint": "9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "myfx": "^1.15.12",
    "postcss": "^8.4.38",
    "prettier": "^2.8.3",
    "rollup-plugin-banner2": "1.2.2",
    "rollup-plugin-clear": "2.0.7",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-scss": "^3.0.0",
    "rollup-plugin-serve": "^2.0.1",
    "rollup-plugin-typescript2": "0.33.0",
    "sass": "^1.72.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  }
}